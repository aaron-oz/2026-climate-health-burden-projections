# Copy to run_env.sh and edit. run_env.sh is machine-specific and gitignored,
# so it survives a git pull and never causes a merge conflict.

# Where the local CCKP mirror lives. Must contain cmip6-daily-x0.25/ and
# pop-x0.25/ laid out exactly as the public bucket does.
export CCKP_LOCAL_ROOT=/data

# Only if the population files sit under a different root than temperature.
# export CCKP_POP_LOCAL_ROOT=/data/pop

# How many locations to run at once.
export JOBS=100

# Cap on workers given to any single location (default 4). Lower it to 2 or 1
# if the machine runs short of memory during the run. Peak per combo after the
# in-country cell selection is roughly 3 GB for the US and 4 GB for Russia,
# against 20 GB and 14 GB before it, so 4 workers now costs less than one
# worker used to.
export MAX_WORKERS_PER_LOCATION=4
